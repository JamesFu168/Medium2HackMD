{
  "manifest_version": 3,
  "name": "Medium2HackMD - Medium 文章擷取、ChatGPT 繁中翻譯與 HackMD 發佈助手",
  "version": "1.2.0",
  "description": "擷取 Medium 文章與圖片暫存至 Library，一鍵帶入 Prompt 至 ChatGPT 產生繁體中文 Markdown，並上傳圖片與內容至 HackMD。",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://medium.com/*",
    "https://*.medium.com/*",
    "https://miro.medium.com/*",
    "https://cdn-images-1.medium.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://hackmd.io/*",
    "https://*.hackmd.io/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "開啟 Medium2HackMD 側邊欄",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
